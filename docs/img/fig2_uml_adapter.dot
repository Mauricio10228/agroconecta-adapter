digraph G {
 graph [rankdir=TB, nodesep=0.35, ranksep=0.7, fontname="Liberation Sans", pad=0.2, newrank=true];
 node [fontname="Liberation Sans"]; edge [fontname="Liberation Sans", fontsize=10];
 CFG [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F3E5F5" COLOR="#6A1B9A"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«raíz de composición»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>ConfiguracionLogistica</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ crear(proveedorLocal : ServicioEnvio) : LogisticaService<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>, shape=plaintext];
 C [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E8F5E9" COLOR="#1B5E20"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«Client»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>LogisticaService</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- proveedores : Map&lt;String, ServicioEnvio&gt;<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ cotizar(proveedor, origen, destino,<BR ALIGN="LEFT"/>    pesoKg : double) : double<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>, shape=plaintext];
 T [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E3F2FD" COLOR="#0D47A1"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«Target (interface)»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><I>ServicioEnvio</I></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ calcularCosto(origen : String, destino : String,<BR ALIGN="LEFT"/>    peso : double) : double<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>, shape=plaintext];
 L [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF" COLOR="#555555"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«implementación existente»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>Proveedor local</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ calcularCosto(origen, destino, peso)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>, shape=plaintext];
 AR [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF3E0" COLOR="#E65100"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«Adapter»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>RapidExpressAdapter</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- api : RapidExpressAPI<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ calcularCosto(origen, destino, peso)<BR ALIGN="LEFT"/>   ruta = origen + &quot;-&quot; + destino<BR ALIGN="LEFT"/>   gramos = round(peso * 1000)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>, shape=plaintext];
 AA [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF3E0" COLOR="#E65100"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«Adapter (nuevo requisito)»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>AndinaCargoAdapter</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- api : AndinaCargoAPI<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ calcularCosto(origen, destino, peso)<BR ALIGN="LEFT"/>   libras = peso * 2.20462<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>, shape=plaintext];
 XR [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F5F5F5" COLOR="#333333"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«Adaptee»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>RapidExpressAPI</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ getShippingPrice(route : String,<BR ALIGN="LEFT"/>    weightInGrams : int) : double<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>, shape=plaintext];
 XA [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F5F5F5" COLOR="#333333"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«Adaptee»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>AndinaCargoAPI</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ quote(originCity, destinationCity : String,<BR ALIGN="LEFT"/>    weightInPounds : double) : double<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>, shape=plaintext];
 C -> T [arrowhead=vee, headlabel="1..*  ", label="  usa"];
 T -> L [dir=back, arrowtail=empty, style=dashed];
 T -> AR [dir=back, arrowtail=empty, style=dashed];
 T -> AA [dir=back, arrowtail=empty, style=dashed];
 AR -> XR [arrowhead=vee, label=" adapta"];
 AA -> XA [arrowhead=vee, label=" adapta"];
 CFG -> C [arrowhead=vee, style=dashed, color="#6A1B9A", fontcolor="#6A1B9A", label="«create»"];
 CN [shape=note, style=filled, fillcolor="#F3E5F5", color="#6A1B9A", fontsize=10, label="Registra LOCAL, RAPID y ANDINA\len el Map que recibe LogisticaService\l"];
 CFG -> CN [style=dotted, arrowhead=none, color="#6A1B9A"];
 {rank=same; CFG; C}
 {rank=same; L; AR; AA}
 {rank=same; XR; XA}
}