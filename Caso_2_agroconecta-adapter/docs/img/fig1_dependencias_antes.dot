digraph G {
 graph [rankdir=TB, nodesep=0.5, ranksep=0.7, fontname="Liberation Sans", pad=0.15];
 node [fontname="Liberation Sans"]; edge [fontname="Liberation Sans", fontsize=10];
 A [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FDECEA" COLOR="#B71C1C"><TR><TD ALIGN="CENTER"><B>LogisticaServiceAjustado</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- proveedorLocal : ServicioEnvio<BR ALIGN="LEFT"/>- rapidExpress : RapidExpressAPI<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ cotizar(proveedor : String,<BR ALIGN="LEFT"/>    origen : String, destino : String,<BR ALIGN="LEFT"/>    pesoKg : double) : double<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>, shape=plaintext];
 S [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#EEF3F8" COLOR="#333333"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«interface»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><I>ServicioEnvio</I></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ calcularCosto(origen : String,<BR ALIGN="LEFT"/>    destino : String,<BR ALIGN="LEFT"/>    peso : double) : double<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>, shape=plaintext];
 R [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F5F5F5" COLOR="#333333"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«librería externa (no modificable)»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>RapidExpressAPI</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ getShippingPrice(route : String,<BR ALIGN="LEFT"/>    weightInGrams : int) : double<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>, shape=plaintext];
 A -> S [arrowhead=vee, label="  usa (abstracción)"];
 A -> R [arrowhead=vee, color="#B71C1C", fontcolor="#B71C1C", penwidth=2, label="  depende de clase concreta\l  (formato y unidades propios)\l"];
}