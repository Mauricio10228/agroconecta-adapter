digraph G {
 graph [rankdir=TB, nodesep=0.35, ranksep=0.55, fontname="Liberation Sans", pad=0.15, newrank=true];
 node [fontname="Liberation Sans"]; edge [fontname="Liberation Sans", fontsize=10];
 CFG [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F3E5F5" COLOR="#6A1B9A"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«raíz de composición»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>ConfiguracionDescuentos</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ crearCatalogo() :<BR ALIGN="LEFT"/>    CatalogoPoliticas<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>, shape=plaintext];
 PC [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF" COLOR="#555555"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«proceso principal»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>ProcesadorCompra</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- calculador<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ procesar(tipoDescuento,<BR ALIGN="LEFT"/>    valorCompra) : ResumenCompra<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>, shape=plaintext];
 C [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E8F5E9" COLOR="#1B5E20"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«Context»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>CalculadorDescuento</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- catalogo : CatalogoPoliticas<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ calcular(tipo : String,<BR ALIGN="LEFT"/>    valorCompra : double) : double<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>, shape=plaintext];
 K [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFFFF" COLOR="#555555"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«registro de estrategias»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>CatalogoPoliticas</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- politicas : Map&lt;String,<BR ALIGN="LEFT"/>    PoliticaDescuento&gt;<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ registrar(politica)<BR ALIGN="LEFT"/>+ retirar(codigo) : boolean<BR ALIGN="LEFT"/>+ buscar(codigo) : Optional<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>, shape=plaintext];
 S [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#E3F2FD" COLOR="#0D47A1"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«Strategy (interface)»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B><I>PoliticaDescuento</I></B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"> </FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ codigo() : String<BR ALIGN="LEFT"/>+ calcular(valorCompra :<BR ALIGN="LEFT"/>    double) : double<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>, shape=plaintext];
 P1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF3E0" COLOR="#E65100"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«ConcreteStrategy»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>DescuentoPorcentual</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- codigo : String<BR ALIGN="LEFT"/>- porcentaje : double<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ calcular(valorCompra)<BR ALIGN="LEFT"/>  valorCompra * porcentaje<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>, shape=plaintext];
 P2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFF3E0" COLOR="#E65100"><TR><TD ALIGN="CENTER"><FONT POINT-SIZE="10">«ConcreteStrategy (nuevo requisito)»</FONT></TD></TR><TR><TD ALIGN="CENTER"><B>DescuentoAniversario</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">- porcentaje, desde, hasta<BR ALIGN="LEFT"/>- reloj : Clock<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">+ calcular(valorCompra)<BR ALIGN="LEFT"/>  solo si hoy está en la vigencia<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>, shape=plaintext];
 PC -> C [arrowhead=vee, label="  usa"];
 C -> K [arrowhead=vee, label="  consulta"];
 K -> S [dir=back, arrowtail=odiamond, arrowhead=none, label="  0..*"];
 S -> P1 [dir=back, arrowtail=empty, style=dashed];
 S -> P2 [dir=back, arrowtail=empty, style=dashed];
 CFG -> K [arrowhead=vee, style=dashed, color="#6A1B9A", fontcolor="#6A1B9A", label="«create»"];
 {rank=same; CFG; PC; C}
 {rank=same; K; S}
 {rank=same; P1; P2}
}